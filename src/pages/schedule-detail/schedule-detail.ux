<template>
  <div class="page-container" onswipe="onSwipe">
    <div class="selector-bar" onclick="onTogglePanel">
      <text class="selector-text">{{displayLabel}}</text>
    </div>
    <div if="{{expanded}}" class="picker-panel">
      <picker
        type="text"
        class="week-picker"
        range="{{weekOptions}}"
        selected="{{selWeekIndex}}"
        onchange="onWeekChange"
      ></picker>
      <picker
        type="text"
        class="day-picker"
        range="{{dayOptions}}"
        selected="{{selDayIndex}}"
        onchange="onDayChange"
      ></picker>
    </div>
    <div class="scroll-container">
      <scroll scroll-y="true" class="lesson-scroll">
        <div class="lesson-list">
          <div if="{{lessons.length === 0}}" class="empty-wrap">
            <text class="empty-text">今日无课</text>
          </div>
          <div
            for="{{lessons}}"
            tid="id"
            class="{{$item.isDivider ? 'divider-line' : 'lesson-item'}}"
            onclick="onLessonTap($idx)"
          >
            <div if="{{!$item.isDivider}}" class="lesson-content">
              <marquee id="{{$item.marqueeId}}" class="lesson-name" scrollamount="{{20}}" loop="{{-1}}" text-offset="40">{{ $item.name }}</marquee>
              <text class="lesson-time">{{ $item.time }}</text>
            </div>
          </div>
        </div>
      </scroll>
    </div>
    <div class="bottom-bar" onclick="onAboutTap">
      <image class="about-icon" src="/common/about.png"></image>
    </div>
  </div>
</template>

<style>
.page-container {
  flex-direction: column;
  width: 100%;
  height: 100%;
  background-color: #000000;
}

.selector-bar {
  flex-direction: row;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  margin-top: 48px;
  margin-left: 36px;
  margin-right: 36px;
  padding: 14px 0;
  background-color: #2a2a2a;
  border-radius: 12px;
  border: 2px solid #444444;
}

.selector-text {
  font-size: 24px;
  color: #ffffff;
  text-align: center;
}

.picker-panel {
  flex-direction: row;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  height: 128px;
  margin: 12px 16px 0 16px;
  padding: 8px 12px;
  background-color: #2a2a2a;
  border-radius: 12px;
  border: 2px solid #444444;
}

.week-picker,
.day-picker {
  flex-grow: 1;
  height: 112px;
  font-size: 20px;
  selected-font-size: 22px;
  color: #ffffff;
  text-align: center;
}

.week-picker {
  margin-right: 6px;
}

.day-picker {
  margin-left: 6px;
}

.scroll-container {
  flex-grow: 1;
  flex-shrink: 1;
  flex-basis: 0px;
  position: relative;
  margin-top: 12px;
}

.lesson-scroll {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  flex-direction: column;
}

.lesson-list {
  flex-direction: column;
  width: 100%;
  flex-grow: 1;
}

.empty-wrap {
  flex-direction: column;
  justify-content: center;
  align-items: center;
  flex-grow: 1;
}

.empty-text {
  font-size: 24px;
  color: #aaaaaa;
}

.lesson-item {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 10px 16px;
  margin: 3px 16px;
  border-radius: 10px;
  background-color: #2a2a2a;
}

.lesson-content {
  flex-direction: column;
  width: 0;
  flex-grow: 1;
  flex-shrink: 1;
  flex-basis: 0px;
}

.lesson-name {
  width: 100%;
  font-size: 22px;
  color: #ffffff;
  font-weight: bold;
}

.lesson-time {
  font-size: 17px;
  color: #aaaaaa;
  margin-top: 2px;
}

.divider-line {
  height: 2px;
  margin: 6px 24px;
  background-color: #444444;
}

.bottom-bar {
  flex-direction: row;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  padding: 8px 0 16px 0;
}

.about-icon {
  width: 24px;
  height: 24px;
}
</style>

<script>
import router from "@system.router"
import storage from "@system.storage"
import { engine, init, getScheduleToday } from "../../common/scheduleEngine"

const WEEKDAYS = ["mon", "tue", "wed", "thu", "fri", "sat", "sun"]
const DAY_LABELS = ["一", "二", "三", "四", "五", "六", "日"]

export default {
  protected: {
    weekIndex: 0,
    dayIndex: 0
  },

  private: {
    expanded: false,
    displayLabel: "",
    weekOptions: [],
    dayOptions: [],
    lessons: [],
    selWeekIndex: 0,
    selDayIndex: 0,
    _marqueeTimer: null
  },

  async onInit() {
    this.selWeekIndex = parseInt(this.weekIndex, 10) || 0
    this.selDayIndex = parseInt(this.dayIndex, 10) || 0
    if (!engine.inited) {
      await init(storage)
    }
    this.buildOptions()
    this.updateDisplayLabel()
    this.refreshLessons()
  },

  onShow() {
    this.refreshLessons()
  },

  onHide() {
    if (this._marqueeTimer) {
      clearTimeout(this._marqueeTimer)
      this._marqueeTimer = null
    }
    this.stopLessonMarquees()
  },

  onDestroy() {
    if (this._marqueeTimer) {
      clearTimeout(this._marqueeTimer)
      this._marqueeTimer = null
    }
    this.stopLessonMarquees()
  },

  buildOptions() {
    const totalWeeks = Math.max(engine.schedule.length, 1)
    const weekOptions = []
    for (let i = 0; i < totalWeeks; i++) {
      weekOptions.push("课表" + (i + 1))
    }
    const dayOptions = []
    for (let i = 0; i < 7; i++) {
      dayOptions.push("周" + DAY_LABELS[i])
    }
    this.weekOptions = weekOptions
    this.dayOptions = dayOptions
  },

  onTogglePanel() {
    this.expanded = !this.expanded
  },

  onSwipe(e) {
    if (e && e.direction === "right") {
      router.back()
    }
  },

  onAboutTap() {
    router.push({
      uri: "/pages/about"
    })
  },

  onLessonTap(index) {
    const lesson = this.lessons[index]
    if (!lesson || lesson.isDivider) {
      return
    }
    router.push({
      uri: "/pages/course-detail",
      params: {
        scheduleId: this.selWeekIndex,
        dayKey: WEEKDAYS[this.selDayIndex],
        lessonIndex: index
      }
    })
  },

  onWeekChange(e) {
    if (!e) return
    this.selWeekIndex = parseInt(e.newSelected, 10) || 0
    this.updateDisplayLabel()
    this.refreshLessons()
  },

  onDayChange(e) {
    if (!e) return
    this.selDayIndex = parseInt(e.newSelected, 10) || 0
    this.updateDisplayLabel()
    this.refreshLessons()
  },

  updateDisplayLabel() {
    this.displayLabel =
      "课表" + (this.selWeekIndex + 1) + " 周" + DAY_LABELS[this.selDayIndex]
  },

  scheduleLessonMarquees() {
    if (this._marqueeTimer) {
      clearTimeout(this._marqueeTimer)
    }
    this._marqueeTimer = setTimeout(() => {
      this._marqueeTimer = null
      this.startLessonMarquees()
    }, 200)
  },

  startLessonMarquees() {
    for (let i = 0; i < this.lessons.length; i++) {
      const lesson = this.lessons[i]
      if (!lesson || lesson.isDivider || !lesson.marqueeId) {
        continue
      }
      const marquee = this.$element(lesson.marqueeId)
      if (marquee && marquee.start) {
        marquee.start()
      }
    }
  },

  stopLessonMarquees() {
    for (let i = 0; i < this.lessons.length; i++) {
      const lesson = this.lessons[i]
      if (!lesson || lesson.isDivider || !lesson.marqueeId) {
        continue
      }
      const marquee = this.$element(lesson.marqueeId)
      if (marquee && marquee.stop) {
        marquee.stop()
      }
    }
  },

  refreshLessons() {
    const dayKey = WEEKDAYS[this.selDayIndex]
    const override = engine.scheduleOverride
    const lessons = getScheduleToday(
      engine.schedule,
      this.selWeekIndex,
      dayKey,
      override && override.date ? override : { date: "1970-01-01", override: [] }
    )
    this.lessons = lessons.map((lesson, index) => ({
      ...lesson,
      id: this.selWeekIndex + ":" + this.selDayIndex + ":" + index,
      marqueeId: "schedule-lesson-name-" + index
    }))
    this.scheduleLessonMarquees()
  }
}
</script>
