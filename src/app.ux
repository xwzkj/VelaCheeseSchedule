<script>
import storage from "@system.storage"
import interconnect from "@system.interconnect"
import prompt from "@system.prompt"
import vibrator from "@system.vibrator"
import resident from "@system.resident"
import protocol from "./common/protocol.json"
import { init, applyConfigString, engine, startTimers, stopTimers, getScheduleToday } from "./common/scheduleEngine"
import { createVibrationPlayer } from "./common/vibrationPlayer"
import {
  getVibrationEnabled,
  getVibrationMode,
  getVibrationPattern,
  onVibrationChange,
  onVibrationModeChange
} from "./common/userSettings"

const vibrationPlayer = createVibrationPlayer(vibrator)
let pendingVibrationRequest = null

function showPreviewError() {
  prompt.showToast({ message: "振动预览失败", duration: 1000 })
}

export default {
  private: {
    _timer: null,
    _lastActiveIndex: -1,
    _vibrationLoaded: false,
    _vibrationMode: "standard",
    _backgroundSnapshotReady: false,
    _unsubVibration: null,
    _unsubVibrationMode: null,
    _isResident: false
  },
  async onCreate() {
    this._unsubVibration = onVibrationChange((enabled) => {
      this.updateVibrationAndResident(enabled)
    })
    this._unsubVibrationMode = onVibrationModeChange((mode) => {
      this._vibrationMode = mode
    })
    await init(storage)
    await this.startBackgroundVibration()
    const connect = interconnect.instance()
    connect.onmessage = async (data) => {
      const content = (data && data.data) || ""
      try {
        // 回复手机发的心跳包
        let wrapper = JSON.parse(content)
        if (wrapper && wrapper.type === "heart-beat" && wrapper.version === protocol.version) {
          connect.send({
            data: {
              version: protocol.version,
              type: "heart-beat",
              data: ""
            }
          })
          return
        }
      } catch (e) {}
      const result = await applyConfigString(content, storage)
      let messageText
      if (result && result.success) {
        messageText = "配置已更新，请重启手环端软件"
        prompt.showToast({ message: "配置已更新\n请重启软件", duration: 2000 })
      } else {
        const reason = (result && result.reason) || "未知错误"
        messageText = "同步失败：" + reason
        prompt.showToast({ message: messageText, duration: 2000 })
      }
      connect.send({
        data: {
          version: protocol.version,
          type: "message",
          data: messageText
        }
      })
    }
  },

  async onShow() {
    const enabled = await getVibrationEnabled(storage)
    this._vibrationMode = await getVibrationMode(storage)
    this.updateVibrationAndResident(enabled)
  },

  async startBackgroundVibration() {
    await init(storage)
    const enabled = await getVibrationEnabled(storage)
    this._vibrationMode = await getVibrationMode(storage)
    this.updateVibrationAndResident(enabled)
    startTimers()
    if (this._timer) clearInterval(this._timer)
    this._timer = setInterval(() => {
      const lessons = getScheduleToday(engine.schedule, engine.currentScheduleId, engine.today, engine.scheduleOverride)
      let activeIndex = -1
      for (let i = 0; i < lessons.length; i++) {
        if (!lessons[i].isDivider && lessons[i].active === 2) { activeIndex = i; break }
      }
      if (!this._backgroundSnapshotReady) {
        this._lastActiveIndex = activeIndex
        this._backgroundSnapshotReady = true
        return
      }
      const lessonChanged = activeIndex !== this._lastActiveIndex
      const hadActiveLesson = this._lastActiveIndex >= 0
      const hasActiveLesson = activeIndex >= 0
      this._lastActiveIndex = activeIndex
      if (lessonChanged && (hadActiveLesson || hasActiveLesson) && this._vibrationLoaded) {
        this.playVibrationPattern()
      }
    }, 1000)
  },

  playVibrationPattern() {
    if (!this._vibrationLoaded || pendingVibrationRequest || vibrationPlayer.isPlaying()) return
    const request = {}
    pendingVibrationRequest = request
    return this.runVibrationPattern(request)
  },

  async runVibrationPattern(request) {
    try {
      // 页面和应用可能由不同模块实例加载，切换模式时以存储值为准。
      const mode = await getVibrationMode(storage)
      if (pendingVibrationRequest !== request || !this._vibrationLoaded) return
      this._vibrationMode = mode
      vibrationPlayer.play(getVibrationPattern(mode), "reminder")
    } catch (e) {
      console.error("app: vibrator failed", e)
    } finally {
      if (pendingVibrationRequest === request) pendingVibrationRequest = null
    }
  },

  previewVibrationPattern(mode) {
    pendingVibrationRequest = null
    return vibrationPlayer.play(getVibrationPattern(mode), "preview", showPreviewError)
  },

  stopVibrationPreview() {
    vibrationPlayer.stop("preview")
  },

  updateVibrationAndResident(enabled) {
    const nextEnabled = !!enabled
    if (!nextEnabled) {
      pendingVibrationRequest = null
      vibrationPlayer.stop("reminder")
    }
    this._vibrationLoaded = nextEnabled
    if (nextEnabled) {
      this.startResident()
    } else {
      this.stopResident()
    }
  },

  startResident() {
    if (this._isResident) return
    try {
      if (resident && typeof resident.start === "function") {
        const result = resident.start({desc: 'run'})
        if (result && typeof result.catch === "function") {
          result.catch((e) => console.error("app: resident start rejected", e))
        }
        this._isResident = true
      }
    } catch (e) {
      console.error("app: resident start exception", e)
    }
  },

  stopResident() {
    if (!this._isResident) return
    try {
      if (resident && typeof resident.stop === "function") {
        resident.stop()
      }
    } catch (e) {
      console.error("app: resident stop exception", e)
    } finally {
      this._isResident = false
    }
  },

  onDestroy() {
    if (this._timer) {
      clearInterval(this._timer)
      this._timer = null
    }
    pendingVibrationRequest = null
    vibrationPlayer.stop()
    stopTimers()
    if (this._unsubVibration) {
      this._unsubVibration()
      this._unsubVibration = null
    }
    if (this._unsubVibrationMode) {
      this._unsubVibrationMode()
      this._unsubVibrationMode = null
    }
    this.stopResident()
  }
}
</script>
